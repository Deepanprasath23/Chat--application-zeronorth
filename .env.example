# Backend Configuration
PROJECT_NAME="Real-Time Chat Application"
API_V1_STR="/api"

# Secret key used for local JWT authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-12345"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (server-only; never put this in frontend/.env)
# Example PostgreSQL / Supabase Postgres string:
# DATABASE_URL="postgresql://postgres.your-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
DATABASE_URL="sqlite:///./chat_app.db"

# Optional Supabase Auth JWT verification; keep all values server-only.
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_JWT_SECRET=""

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
